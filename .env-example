# Copy to .env in the project root (or export these directly in your
# deployment environment) and fill in real values before running the
# server. See internal/config/config.go for defaults and validation.

# --- Server ---
LISTEN_ADDR=:8080
READ_TIMEOUT=30s
WRITE_TIMEOUT=60s
IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=15s
RUST_API_TOKEN=

# --- Storage driver: "local" or "s3" ---
STORAGE_DRIVER=local
# Rust sends complete, filesystem-absolute keys (e.g. /data/orgs/123/...)
# and expects them written exactly there. Keep this "/" so the local
# driver doesn't nest those absolute keys under an extra base directory.
LOCAL_BASE_PATH=/

# --- S3 / MinIO / Ceph (only used when STORAGE_DRIVER=s3) ---
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=true

# --- Redis session store ---
# Every issued session (upload, download, stream, WOPI) is cached here,
# keyed by its opaque token, with a TTL; revocation just deletes the key.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Token encryption ---
# Base64-encoded 32-byte (AES-256) key used to seal every issued session
# token around its file_id. Required. Generate with `openssl rand -base64 32`.
TOKEN_ENCRYPTION_KEY=


# --- Storage capacity admission control ---
# Once the storage backend's used capacity reaches this percentage,
# new upload sessions are refused with 507 Insufficient Storage (only
# enforced for backends that report real usage, e.g. the local driver;
# object stores like S3 have no finite capacity to check). Set to 0 to
# disable.
MAX_STORAGE_USAGE_PERCENT=90
# Retry-After hint (seconds-equivalent duration) sent alongside a 507,
# telling the caller how long to back off before trying again.
STORAGE_BACKOFF=30s
# Caps how many files a single /sessions/upload request may authorize
# at once (all under one token).
MAX_UPLOAD_BATCH_SIZE=50

# --- Tus resumable uploads ---
TUS_BASE_PATH=/upload/tus/
TUS_MAX_UPLOAD_SIZE=10737418240
# Comma-separated exact origins allowed to make cross-origin requests to
# the tus endpoint (e.g. https://app.example.com,http://localhost:3000).
# Leave empty to allow any origin.
TUS_CORS_ALLOWED_ORIGINS=

# Where in-progress tus uploads are staged. Independent of LOCAL_BASE_PATH
# on purpose (that may be "/" above, which is not a safe staging area).
TUS_STAGING_DIR=/data/_tus-staging

# Same as TUS_CORS_ALLOWED_ORIGINS, but for /download/{fileID} — the other
# endpoint the React app's browser JS calls directly (fetch/XHR) rather
# than server-to-server or via a plain navigation.
DOWNLOAD_CORS_ALLOWED_ORIGINS=

# --- Logging ---
LOG_LEVEL=info
LOG_OUTPUT=file     # file|stdout|stderr
LOG_DIR=./logs
LOG_FILE_NAME=storage-api.log
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=7
LOG_MAX_AGE_DAYS=30

# --- WOPI ---
WOPI_HOST_BASE_URL=

# --- Rust API callbacks ---
# Where the Storage API reports upload results back to (POST
# /internal/callback/upload/{is_success}).
RUST_CALLBACK_BASE_URL=
RUST_CALLBACK_API_KEY=